# MongoDB connection string. If left empty, the app runs in DEMO MODE
# with no persistence (analyses/citizen-reports are not saved permanently).
MONGO_URI=

# Secret used to sign JWTs. Set a strong random value in production.
JWT_SECRET=

# Optional: enables AI-generated natural-language explanations via the
# Anthropic API. If empty, a deterministic rule-based explanation is used.
AI_API_KEY=

# Optional: Google Earth Engine project id. If empty, satelliteService.js
# automatically falls back to the seeded demo dataset.
GEE_PROJECT_ID=

PORT=5000
